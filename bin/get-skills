#!/usr/bin/env sh
set -eu

MANIFEST_NAME=.toolshed-get-skills

REPO_URL=""

while [ $# -gt 0 ]; do
	case "$1" in
	--url)
		REPO_URL="${2:-}"
		shift 2
		;;
	*)
		echo "toolshed:get-skills: unknown argument: $1" >&2
		exit 1
		;;
	esac
done

REPO_URL="${REPO_URL:-https://github.com/caido/ai-ops}"

valid_skill_name() {
	if expr "x$1" : 'x[A-Za-z0-9][A-Za-z0-9._-]\{0,127\}$' >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

install_dir_for_choice() {
	if [ -z "${HOME:-}" ]; then
		echo "toolshed:get-skills: HOME is unset or empty" >&2
		exit 1
	fi
	case "$1" in
	1) printf '%s\n' "$HOME/.cursor/skills" ;;
	2) printf '%s\n' "$HOME/.claude/skills" ;;
	3) printf '%s\n' "$HOME/.agents/skills" ;;
	*)
		echo "toolshed:get-skills: expected 1, 2, or 3" >&2
		exit 1
		;;
	esac
}

prompt_install_dir() {
	_d1=$(install_dir_for_choice 1) || exit 1
	_d2=$(install_dir_for_choice 2) || exit 1
	_d3=$(install_dir_for_choice 3) || exit 1
	echo "toolshed:get-skills: install ai-ops skills into which folder?" >&2
	printf '%s\n' "  1) $_d1" >&2
	printf '%s\n' "  2) $_d2" >&2
	printf '%s\n' "  3) $_d3" >&2
	echo "toolshed:get-skills: choice [1-3]:" >&2
	_choice=''
	if ! IFS= read -r _choice; then
		echo "toolshed:get-skills: expected 1, 2, or 3" >&2
		exit 1
	fi
	_cr=$(printf '\r')
	_choice=${_choice%"$_cr"}
	install_dir_for_choice "$_choice"
}

read_owned() {
	_install=$1
	_out=$2
	_manifest="$_install/$MANIFEST_NAME"
	: >"$_out"
	if [ ! -e "$_manifest" ] && [ ! -L "$_manifest" ]; then
		return 0
	fi
	if [ -L "$_manifest" ] || [ ! -f "$_manifest" ]; then
		echo "toolshed:get-skills: manifest is not a file" >&2
		exit 1
	fi
	_raw="$_out.raw"
	: >"$_raw"
	while IFS= read -r _line || [ -n "$_line" ]; do
		if ! valid_skill_name "$_line"; then
			printf '%s\n' "toolshed:get-skills: illegal manifest name: $_line" >&2
			exit 1
		fi
		printf '%s\n' "$_line" >>"$_raw"
	done <"$_manifest"
	_dups=$(LC_ALL=C sort "$_raw" | LC_ALL=C uniq -d)
	if [ -n "$_dups" ]; then
		echo "toolshed:get-skills: duplicate manifest name" >&2
		printf '%s\n' "$_dups" >&2
		exit 1
	fi
	LC_ALL=C sort "$_raw" >"$_out"
}

write_owned() {
	_dir=$1
	_names=$2
	_tmp=$(mktemp "$_dir/$MANIFEST_NAME.XXXXXX")
	cat "$_names" >"$_tmp"
	mv -f "$_tmp" "$_dir/$MANIFEST_NAME"
}

list_source_names() {
	_src=$1
	_out=$2
	_raw="$_out.raw"
	: >"$_raw"
	for _path in "$_src"/.[!.]* "$_src"/..?* "$_src"/*; do
		if [ ! -e "$_path" ] && [ ! -L "$_path" ]; then
			continue
		fi
		if [ ! -d "$_path" ] || [ -L "$_path" ]; then
			continue
		fi
		_name=${_path##*/}
		if ! valid_skill_name "$_name"; then
			printf '%s\n' "toolshed:get-skills: illegal skill name: $_name" >&2
			exit 1
		fi
		printf '%s\n' "$_name" >>"$_raw"
	done
	LC_ALL=C sort -u "$_raw" >"$_out"
}

cleanup() {
	if [ -n "${_work:-}" ]; then
		rm -rf "$_work"
	fi
	if [ "${_stage_ready:-0}" = 1 ] && [ -n "${_stage:-}" ]; then
		rm -rf "$_stage"
	fi
}

install_skills() {
	_src=$1
	_install=$2
	_work=$(mktemp -d)
	_stage=''
	_stage_ready=0
	trap cleanup EXIT

	list_source_names "$_src" "$_work/desired"
	read_owned "$_install" "$_work/owned"

	while IFS= read -r _name || [ -n "$_name" ]; do
		[ -n "$_name" ] || continue
		if grep -F -x -q "$_name" "$_work/desired"; then
			continue
		fi
		if [ -e "$_src/$_name" ] || [ -L "$_src/$_name" ]; then
			printf '%s\n' "toolshed:get-skills: $_name is not a skill directory" >&2
			exit 1
		fi
	done <"$_work/owned"

	_hit=0
	while IFS= read -r _name || [ -n "$_name" ]; do
		[ -n "$_name" ] || continue
		if grep -F -x -q -- "$_name" "$_work/owned"; then
			continue
		fi
		if [ -e "$_install/$_name" ] || [ -L "$_install/$_name" ]; then
			printf '%s\n' "toolshed:get-skills: $_name already exists and is not owned" >&2
			_hit=1
		fi
	done <"$_work/desired"
	if [ "$_hit" != 0 ]; then
		exit 1
	fi

	mkdir -p "$_install"
	_install=$(CDPATH='' cd -- "$_install" && pwd)
	_stage=$(mktemp -d "$_install/.toolshed-get-skills.XXXXXX")
	_stage_ready=1
	while IFS= read -r _name || [ -n "$_name" ]; do
		[ -n "$_name" ] || continue
		cp -R "$_src/$_name" "$_stage/$_name"
	done <"$_work/desired"

	cp "$_work/owned" "$_work/claimed"
	while IFS= read -r _name || [ -n "$_name" ]; do
		[ -n "$_name" ] || continue
		if [ -e "$_install/$_name" ] || [ -L "$_install/$_name" ]; then
			if grep -F -x -q "$_name" "$_work/owned"; then
				rm -rf "${_install:?}/${_name:?}"
			else
				printf '%s\n' "toolshed:get-skills: $_name already exists and is not owned" >&2
				exit 1
			fi
		fi
		mv "$_stage/$_name" "$_install/$_name"
		if grep -F -x -q "$_name" "$_work/owned"; then
			continue
		fi
		printf '%s\n' "$_name" >>"$_work/claimed"
		LC_ALL=C sort -u "$_work/claimed" >"$_work/claimed.sorted"
		mv "$_work/claimed.sorted" "$_work/claimed"
		write_owned "$_install" "$_work/claimed"
	done <"$_work/desired"

	LC_ALL=C comm -23 "$_work/owned" "$_work/desired" >"$_work/remove"
	while IFS= read -r _name || [ -n "$_name" ]; do
		[ -n "$_name" ] || continue
		rm -rf "${_install:?}/${_name:?}"
	done <"$_work/remove"

	write_owned "$_install" "$_work/desired"
	printf '%s\n' "toolshed:get-skills: synced $_src to $_install" >&2
}

_install_choice=$(prompt_install_dir) || exit 1

if ! command -v git >/dev/null 2>&1; then
	echo "toolshed:get-skills: git is required but was not found on PATH" >&2
	exit 1
fi

CACHE="${AI_OPS_SKILLS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mise-toolshed/ai-ops}"
REF="${AI_OPS_SKILLS_REF:-}"

ensure_repo() {
	if [ -d "$CACHE/.git" ]; then
		return 0
	fi
	_parent="$(dirname "$CACHE")"
	mkdir -p "$_parent"
	echo "toolshed:get-skills: cloning $REPO_URL into $CACHE" >&2
	echo "toolshed:get-skills: first run downloads the repo; --progress shows activity (large monorepos can take minutes)." >&2
	# Shallow + single default branch: much faster than a full clone. --progress prints receiving/compressing lines.
	# No GIT_TERMINAL_PROMPT=0 here so HTTPS/SSH can prompt for credentials if needed (avoids some silent stalls).
	git clone --progress --depth 1 --single-branch "$REPO_URL" "$CACHE"
}

sync_ref() {
	_target="$1"
	if [ "$_target" = "latest" ]; then
		git -C "$CACHE" fetch origin
		if git -C "$CACHE" rev-parse --verify origin/main >/dev/null 2>&1; then
			git -C "$CACHE" checkout -B main origin/main
		elif git -C "$CACHE" rev-parse --verify origin/master >/dev/null 2>&1; then
			git -C "$CACHE" checkout -B master origin/master
		else
			echo "toolshed:get-skills: neither origin/main nor origin/master exists after fetch" >&2
			exit 1
		fi
		return 0
	fi

	git -C "$CACHE" fetch origin --tags --prune 2>/dev/null || git -C "$CACHE" fetch origin 2>/dev/null || true

	if git -C "$CACHE" rev-parse --verify "$_target^{commit}" >/dev/null 2>&1; then
		git -C "$CACHE" checkout "$_target"
		return 0
	fi

	echo "toolshed:get-skills: ref $_target not found in ai-ops, using default branch" >&2
	sync_ref latest
}

ensure_repo

# Non-interactive fetch/checkout: fail fast instead of hanging on credential prompts in CI.
export GIT_TERMINAL_PROMPT=0

if [ -n "$REF" ]; then
	sync_ref "$REF" >&2
else
	sync_ref latest >&2
fi

SRC="$CACHE/skills"
if [ ! -d "$SRC" ]; then
	echo "toolshed:get-skills: missing $SRC after checkout (is the repo OK?)" >&2
	exit 1
fi

install_skills "$SRC" "$_install_choice"
