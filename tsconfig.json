{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/read-package-version.ts",
    "scripts/tool-version.d.ts",
    "test/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/test-support/report-sites.ts",
    "packages/check-exact-versions/src/**/*.ts",
    "packages/check-lockfiles/src/**/*.ts",
    "packages/check-minimum-release-age/src/**/*.ts"
  ]
}
